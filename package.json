{
  "name": "pts-plan",
  "displayName": "Pixel Plan Injection",
  "version": "2.13.2",
  "description": "Бесплатное расширение, которое превращает стандартный Bitrix24 в удобный рабочий инструмент.",
  "keywords": [
    "chrome-extension",
    "vue",
    "vite",
    "create-chrome-ext"
  ],
  "license": "MIT",
  "author": "MelentQ",
  "type": "module",
  "scripts": {
    "build": "npm run build-css && vite build",
    "build-css": "npx @tailwindcss/cli -i src/css/content-styles.css -o public/assets/content-styles.css --minify && npm run copy-assets",
    "copy-assets": "cp -r node_modules/primeicons/fonts/ public/assets/",
    "dev": "npm run build-css && vite",
    "preview": "npm run build-css && vite preview"
  },
  "dependencies": {
    "@primeuix/themes": "^2.0.3",
    "axios": "^1.20.0",
    "chart.js": "^4.5.1",
    "dayjs": "^1.11.23",
    "jsonrepair": "^3.15.0",
    "jszip": "^3.10.2",
    "lodash-es": "^4.18.1",
    "marked": "^18.1.0",
    "primeicons": "^8.0.2",
    "primelocale": "^2.5.0",
    "primevue": "^4.5.5",
    "vue": "^3.5.43",
    "vue-color": "^3.3.3"
  },
  "devDependencies": {
    "@crxjs/vite-plugin": "^2.7.1",
    "@eslint/js": "^10.0.1",
    "@tailwindcss/cli": "^4.3.3",
    "@tailwindcss/vite": "^4.3.3",
    "@vitejs/plugin-vue": "^6.0.9",
    "chrome-types": "^0.1.452",
    "eslint": "^10.12.0",
    "eslint-plugin-simple-import-sort": "^14.0.0",
    "eslint-plugin-vue": "^10.11.1",
    "globals": "^17.13.0",
    "tailwindcss": "^4.1.17",
    "tailwindcss-primeui": "^0.6.1",
    "vite": "^7.3.7"
  },
  "engines": {
    "node": ">=20.19.6"
  }
}
